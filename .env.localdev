# Local development environment — NEVER commit this file.
# Used exclusively by docker-compose.local.yml (project: behiveads-local).
# Has no connection to production, AWS EC2, or behiveads.com.

# ── Environment flag ──────────────────────────────────────────────────────────
WP_ENV=local

# ── Local site URL (served by Apache on port 8080, no Caddy) ─────────────────
WP_HOME=http://localhost:8081

# ── Local-only MySQL credentials (isolated from production) ──────────────────
MYSQL_DATABASE=wp_local
MYSQL_USER=wp_local_user
MYSQL_PASSWORD=wp_local_pass_2024
MYSQL_ROOT_PASSWORD=wp_local_root_2024

WORDPRESS_DB_HOST=db_local
WORDPRESS_DB_NAME=wp_local
WORDPRESS_DB_USER=wp_local_user
WORDPRESS_DB_PASSWORD=wp_local_pass_2024
WORDPRESS_DB_PORT=3306
WORDPRESS_TABLE_PREFIX=wp_

# ── Disable the production URL variable so wp-config.php never uses it ───────
RENDER_EXTERNAL_URL=http://localhost:8081

# ── WordPress debug (safe for local) ─────────────────────────────────────────
WP_DEBUG=true
WP_DEBUG_LOG=true
WP_DEBUG_DISPLAY=false
