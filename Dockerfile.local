# ============================================================================
# Dockerfile.local — local development image for behiveads-local.
# Based on the production Dockerfile but:
#   - Uses local-entrypoint.sh instead of entrypoint.sh
#   - Copies local-restore-inner.sh (the one-time DB/files restore script)
#   - Does NOT copy setup.sh (which would overwrite URLs with production value)
# Production Dockerfile is unchanged.
# ============================================================================

FROM wordpress:php8.2-apache

# ---------- System dependencies ----------
RUN apt-get update && apt-get install -y \
    less \
    curl \
    default-mysql-client \
    && rm -rf /var/lib/apt/lists/*

# ---------- WP-CLI ----------
RUN curl -sO https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar \
    && chmod +x wp-cli.phar \
    && mv wp-cli.phar /usr/local/bin/wp

# ---------- Apache ----------
RUN a2enmod rewrite
RUN sed -i 's/AllowOverride None/AllowOverride All/g' /etc/apache2/apache2.conf

# ---------- wp-config.php ----------
COPY wp-config.php /var/www/html/wp-config.php

# ---------- Theme ----------
COPY theme/ /var/www/html/wp-content/themes/habitat-leadgen/

# ---------- Local scripts only (NOT setup.sh / entrypoint.sh) ----------
COPY local-entrypoint.sh /local-entrypoint.sh
COPY local-restore-inner.sh /local-restore-inner.sh
RUN chmod +x /local-entrypoint.sh /local-restore-inner.sh

RUN chown -R www-data:www-data /var/www/html/wp-content/themes/habitat-leadgen/

EXPOSE 80

ENTRYPOINT ["/local-entrypoint.sh"]
