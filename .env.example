# Copy this file to .env.local / .env.development / .env.production
# and fill in the real values. Never commit real credentials.

# Database
WORDPRESS_DB_NAME=your_database_name
WORDPRESS_DB_USER=your_database_user
WORDPRESS_DB_PASSWORD=your_database_password
WORDPRESS_DB_HOST=your_database_host
WORDPRESS_DB_PORT=3306
WORDPRESS_TABLE_PREFIX=wp_

# Site URL
RENDER_EXTERNAL_URL=https://your-site.onrender.com

# Environment
WP_ENV=production

# WordPress Admin (auto-created on first deploy)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=Admin@1234
WP_ADMIN_EMAIL=admin@behiveads.com
